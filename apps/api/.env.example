# String de conexão do Postgres — aponta para o container do docker-compose.yml
# da raiz do repositório em dev local, ou para o Postgres do Render em produção.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vicina?schema=public"

# Segredo usado para assinar os tokens JWT emitidos pelo módulo auth.
JWT_SECRET=

# Porta em que a API sobe localmente — em produção o Render injeta a sua própria.
PORT=3000

# Origem liberada no CORS: Vite dev server localmente, URL da Vercel em produção.
FRONTEND_URL=http://localhost:5173
